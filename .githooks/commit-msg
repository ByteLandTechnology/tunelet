#!/bin/sh
# Check the commit message format and rules from AGENTS.md.
set -eu

if [ "$#" -lt 1 ] || [ ! -f "$1" ]; then
    printf '%s\n' 'commit-msg: give a valid commit message file.' >&2
    exit 1
fi

awk '
function fail(line_no, rule) {
    printf "commit-msg: line %d: %s\n", line_no, rule
    errors++
}

{
    sub(/\r$/, "")
    if (after_scissors) {
        next
    }
    if ($0 ~ /^# -+ >8 -+$/) {
        comments_at_end = 1
        after_scissors = 1
        next
    }
    if ($0 ~ /^#/) {
        comments_at_end = 1
        next
    }
    comments_at_end = 0
    count++
    lines[count] = $0
    lineno[count] = NR
}

END {
    if (comments_at_end && count >= 1 && lines[count] == "") {
        if (count == 1 || lines[count - 1] != "") {
            count--
        }
    }

    if (count == 0) {
        fail(1, "write a non-empty commit message.")
        exit 1
    }

    header_re = "^(build|chore|ci|deps|docs|feat|fix|perf|refactor|revert|style|test)(\\([a-z0-9][a-z0-9._/-]*\\))?!?: [^ \t](.*[^ \t])?$"
    merge_re = "^Merge ((remote-tracking )?branch(es)? |tag(s)? |commit(s)? |pull request #[0-9]+ from )[^ \t].*$"
    revert_re = "^(Revert|Reapply) \".+\"$"
    hex7_re = "[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]+"
    revert_line_re = "^This reverts commit " hex7_re "\\.$"
    revert_merge1_re = "^This reverts commit " hex7_re ", reversing$"
    revert_merge2_re = "^changes made to " hex7_re "\\.$"

    is_git_merge = (lines[1] ~ merge_re)
    is_git_revert = (lines[1] ~ revert_re)

    for (i = 1; i <= count; i++) {
        line = lines[i]
        ln = lineno[i]
        low = tolower(line)
        bad_meta = 0

        if (length(line) > 72 && !(i == 1 && (is_git_merge || is_git_revert))) {
            fail(ln, "keep each line at or below 72 columns (found " length(line) ").")
        }

        if (index(line, "\\n") > 0) {
            fail(ln, "do not use literal \\n text; write a multi-line message in a file.")
        }

        if (low ~ /(^|[^a-z])(co-authored-by|assisted-by)([^a-z]|$)/) {
            fail(ln, "do not add Co-Authored-By or Assisted-by trailers.")
            bad_meta = 1
        }

        if (low ~ /(^|[^a-z0-9])session([ \t-]+(link|url|id))?[ \t]*:/ ||
            low ~ /https?:\/\/([a-z0-9-]+\.)*(claude\.ai|chatgpt\.com|chat\.openai\.com|ampcode\.com|devin\.ai|cursor\.(com|sh)|(jules|aistudio|gemini)\.google(\.com)?|stitch\.withgoogle(\.com)?|copilot-workspace\.githubnext\.com)([^a-z0-9-]|$)/ ||
            low ~ /https?:\/\/([a-z0-9-]+\.)*github\.com\/copilot([\/?#.]|$)/ ||
            low ~ /https?:\/\/[^ \t]*(\/(sessions?|chats?|conversations?)([\/?#.]|$)|session([_=-][a-z0-9]|[-_]?id[=:/]))/) {
            fail(ln, "do not add agent session links.")
            bad_meta = 1
        }

        if (i == 1) {
            if (line !~ header_re && !is_git_merge && !is_git_revert) {
                fail(ln, "use a Conventional Commits header: type(scope): summary or type: summary.")
            }
        } else if (i == 2) {
            if (line ~ /^[ \t]*$/ && count == 2) {
                fail(ln, "remove extra blank lines.")
            } else if (line ~ /^[ \t]+$/) {
                fail(ln, "remove spaces from the blank line after the header.")
            } else if (line != "") {
                fail(ln, "put one blank line between the header and the body.")
            }
        } else {
            if (line ~ /^[ \t]*$/) {
                if (!(is_git_revert && line == "" && i < count &&
                    (lines[i - 1] ~ revert_line_re || (i == 5 && lines[3] ~ revert_merge1_re && lines[4] ~ revert_merge2_re)))) {
                    fail(ln, "remove extra blank lines.")
                }
            } else if (!bad_meta) {
                if (is_git_revert && (line ~ revert_line_re ||
                    (i == 3 && count >= 4 && line ~ revert_merge1_re && lines[4] ~ revert_merge2_re) ||
                    (i == 4 && lines[3] ~ revert_merge1_re && line ~ revert_merge2_re))) {
                    continue
                }
                if (line !~ /^- [^ \t]/) {
                    fail(ln, "start each body line with \"- \" and do not continue lines.")
                } else if (line ~ /[ \t]$/) {
                    fail(ln, "end each \"- \" bullet with a period and no spaces after it.")
                } else if (line !~ /^- [^ \t.].*\.$/) {
                    fail(ln, "end each \"- \" bullet with a period.")
                }
            }
        }
    }

    if (errors > 0) {
        exit 1
    }
}
' "$1" >&2
